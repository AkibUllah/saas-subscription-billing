APP_ENV=development
LOG_LEVEL=INFO

# SQLite for local dev; PostgreSQL in docker-compose (run `alembic upgrade head` first)
DATABASE_URL=sqlite:///./billing.db
# DATABASE_URL=postgresql+psycopg://billing:billing@db:5432/billing

# Admin API key required on /v1/* when set (leave empty to disable auth in local dev)
API_KEY=change-me

# Default currency and VAT (basis points: 1500 = 15%, the Bangladesh standard rate)
DEFAULT_CURRENCY=BDT
VAT_RATE_BPS=1500

# Payment gateway: mock | stripe_like | bkash_like  (the latter two are clearly-labelled stubs)
PAYMENT_GATEWAY=mock
GATEWAY_API_KEY=
GATEWAY_BASE_URL=

# Dunning: days after the invoice issue date to retry a failed charge; UNPAID after the last one fails
DUNNING_SCHEDULE_DAYS=1,3,5,7
INVOICE_DUE_DAYS=7
INVOICE_NUMBER_PREFIX=INV

# Outgoing webhooks
WEBHOOK_TIMEOUT_SECONDS=5
